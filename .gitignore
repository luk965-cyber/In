# Редактировать на https://www.toptal.com/developers/gitignore?templates=fuelphp,phpstorm+all,php-cs-fixer,phpstorm,phpcodesniffer,phpunit,phpstorm+iml,cakephp2,cakephp,cakephp3,thinkphp

### CakePHP ###
# CakePHP 3

/продавец/*
/config/app.php

/tmp/cache/models/*
!/tmp/cache/models/empty
/tmp/cache/persistent/*
!/tmp/cache/persistent/empty
/tmp/cache/views/*
!/tmp/cache/views/empty
/tmp/sessions/*
!/tmp/sessions/empty
/tmp/tests/*
!/tmp/tests/empty

/логи/*
!/logs/empty

# CakePHP 2

/app/tmp/*
/app/Config/core.php
/app/Config/database.php
/поставщики/*

