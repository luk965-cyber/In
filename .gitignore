### ThinkPHP ###
# Шаблон gitignore для ThinkPHP v3.2.3
# Веб-сайт: http://www.thinkphp.cn/

# Файлы журналов и кэша
/Application/Runtime/

# Общий файл конфигурации
/Application/Common/Conf/config.php
RewriteEngine on
RewriteCond %{THE_REQUEST} /([*.]+)\.html [NC]
RewriteRule /%1 [NC, L,R]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule %{REQUEST_URI}. html [NC, L]

RewriteEngine on
RewriteCond %{THE_REQUEST} /([*.]+)\.html [NC]
RewriteRule /%1 [NC, L,R]
RewriteCond %{REQUEST_FILENAME}. GitHub -f
RewriteRule %{REQUEST_URI}. GitHub [NC, L]

